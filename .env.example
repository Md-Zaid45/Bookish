# Database (Neon Postgres)
DATABASE_URL=

# Auth.js / NextAuth
AUTH_SECRET=

# ImageKit
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=

# App URLs
# Local development URL (optional; uploads use relative paths)
NEXT_PUBLIC_API_ENDPOINT=http://localhost:3000
# Public production URL used to trigger the onboarding workflow.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are used as a fallback.
NEXT_PUBLIC_PROD_API_ENDPOINT=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash / Workflow
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Resend (email)
RESEND_API_KEY=

# Google Gemini (embeddings, local scripts only)
GEMINI_API_KEY=
